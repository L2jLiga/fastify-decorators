{
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "../dist/fastify-decorators",

    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],

    "strict": true,

    "declaration": true,
    "inlineSourceMap": true,
    "inlineSources": true,

    "esModuleInterop": true
  },
  "files": ["index.ts", "plugins/index.ts"],
  "exclude": ["node_modules"]
}
