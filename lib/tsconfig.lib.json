{
  "extends": "./tsconfig.base.json",
  "files": ["index.ts", "Testing/index.ts"],
  "include": ["**/*.ts"],
  "exclude": ["**/*.spec.ts", "**/*.mock.ts"],
  "compilerOptions": {
    "composite": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  }
}
